# Petrios — environment variables
# Copy to .env.local and fill in. Server-only values must never be exposed
# to the browser (only NEXT_PUBLIC_* are).

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only

# --- App URL (required in production) ---------------------------------------
# Used in emailed sign-in links, invite links, and unsubscribe links.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# --- Public privacy/compliance disclosure (required in production) -----------
# Rendered on /privacy, /subprocessors, and the DPA framework. These values are
# public; use the controller's legal identity and an actively monitored inbox.
PRIVACY_CONTROLLER_NAME=Your Organisation Legal Name
PRIVACY_CONTROLLER_ADDRESS=Registered address, town, postcode, country
PRIVACY_CONTACT_EMAIL=privacy@your-production-domain.example
# Cover application, database, and backup regions (for example "UK — London").
DATA_HOSTING_REGION=your-deployment-and-backup-regions
# State the actual mechanism after legal review (for example UK adequacy or IDTA).
DATA_TRANSFER_SAFEGUARDS=your-reviewed-transfer-mechanism

# --- Email via Resend (required for real email) ------------------------------
# Leave RESEND_API_KEY unset in development to log emails to the console
# instead of sending (works for any recipient, no provider needed).
RESEND_API_KEY=your-resend-api-key                # server-only
MAIL_FROM=Petrios <no-reply@your-verified-domain>
# MAIL_DEV_REDIRECT=you@example.com               # funnel ALL dev mail to one inbox (development only — ignored in production builds)
# OUTBOUND_EMAIL_ENABLED=false                    # exactly "false" refuses every send (a copy serving another deployment's database)
# OUTBOUND_EMAIL_ALLOWLIST=you@example.com        # comma-separated addresses still served while OUTBOUND_EMAIL_ENABLED=false

# --- Cron jobs (required if you schedule them) --------------------------------
# Shared secret for /api/cron/* routes: Authorization: Bearer CRON_SECRET
CRON_SECRET=generate-a-long-random-string          # server-only
# CRON_ENABLED=false                               # exactly "false" makes /api/cron/* answer 503 (a copy that must not run jobs)

# Client IP for login-link / group-code rate limits. Set only to a header your
# edge overwrites (e.g. cf-connecting-ip behind Cloudflare); unset = first x-forwarded-for hop.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# --- Time zone (optional) ----------------------------------------------------
# IANA zone for dates the server renders (emails, PDFs, server pages, cron and
# Ops drafts) and for the wall-clock times of teaching slots. Server clocks run
# in UTC and Workers ignore TZ, so set this rather than TZ. Invalid values fall
# back to the default with a logged error. Default: Europe/London
# APP_TIME_ZONE=Europe/London

# --- AI (optional — features degrade gracefully without it) -------------------
# Powers feedback summaries and the Petrios Ops agent layer.
# Provider: LLM_PROVIDER pin, else ANTHROPIC_API_KEY (Claude, the default), else
# OPENAI_API_KEY (optional OpenAI-compatible adapter). With both keys AND a
# custom OPENAI_BASE_URL, AI stays off until LLM_PROVIDER is set.
ANTHROPIC_API_KEY=your-anthropic-api-key           # server-only; use a dedicated workspace
# ANTHROPIC_MODEL=claude-opus-5-5                  # override the default model
# ANTHROPIC_BASE_URL=https://your-gateway.internal # optional Anthropic-compatible gateway
# ANTHROPIC_FALLBACKS=off                          # only for gateways that reject the fallback beta
# LLM_PROVIDER=anthropic                           # anthropic | openai — pin explicitly when both keys exist
# OPENAI_API_KEY=your-openai-api-key               # optional OpenAI-compatible adapter / OpenAI speech
# OPENAI_MODEL=gpt-5.5                             # OpenAI adapter model override

# --- Audio Recap speech (optional) -------------------------------------------
# If TTS_PROVIDER is unset, declaring either ElevenLabs credential selects
# ElevenLabs; otherwise OPENAI_API_KEY selects OpenAI speech; with neither, speech is off.
# TTS_PROVIDER=elevenlabs                          # openai | elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-api-key       # server-only
# ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2       # optional override
# OPENAI_TTS_MODEL=gpt-4o-mini-tts                 # OpenAI-only override
# OPENAI_TTS_VOICE=alloy                           # OpenAI-only override
# For no OpenAI traffic at all: leave OPENAI_API_KEY unset and configure ElevenLabs.

# --- Petrios Ops kill switch (optional) -----------------------------------------
# Unset or anything = on; the literal string "false" halts every ops surface.
# OPS_ENABLED=false

# --- Ops chat assistant (optional, default OFF) ----------------------------------
# The organiser chat assistant ships disabled; opt a deployment in explicitly
# after your own safety review. Still subject to OPS_ENABLED.
# OPS_ASSISTANT_ENABLED=true

# --- Webhooks (optional) ------------------------------------------------------
# Webhook deliveries refuse private, loopback, link-local and internal hosts
# (SSRF guard, lib/webhook-guard.ts). Set to "true" only for local development
# or an in-network self-hosted receiver you trust.
# WEBHOOK_ALLOW_PRIVATE=true

# --- Petrios Meet video (optional) ------------------------------------------------
# JITSI sessions get a video room derived from the session id. One of three
# modes is resolved on the SERVER at request time (lib/meeting/config.ts) and
# changing them needs no rebuild. The JaaS private key and the self-hosted app
# secret never reach the browser; the JaaS AppID and the Jitsi host do (room
# name, CSP), as they must for the embed. Step-by-step: docs/petrios-meet.md.
#
# 1) Public (default, nothing set): rooms open on the free meet.jit.si service in
#    a NEW TAB. Petrios never embeds meet.jit.si: it disconnects embedded calls
#    after 5 minutes, and the first person to arrive (usually the teacher) must
#    sign in to Jitsi to start the room.
#
# 2) 8x8 Jitsi as a Service (recommended): rooms are embedded on the session
#    page and every participant joins with a short-lived room pass (RS256 JWT)
#    minted by Petrios. Set ALL THREE or none (a partial set disables video
#    with a configuration error; there is no fallback to meet.jit.si):
#      a. Create an app at https://jaas.8x8.vc and copy its AppID.
#      b. API keys: generate (or upload) an RSA key pair; copy the key id, which
#         starts with "<AppID>/", and keep the PRIVATE key.
#      c. Store the private key as a server secret. Real newlines or literal \n
#         escapes both work; PKCS#8 (BEGIN PRIVATE KEY) or PKCS#1
#         (BEGIN RSA PRIVATE KEY). Leave JITSI_DOMAIN unset.
#    With JaaS, 8x8 processes meeting data: name it on your DPA register.
# JAAS_APP_ID=vpaas-magic-cookie-0123456789abcdef
# JAAS_API_KEY_ID=vpaas-magic-cookie-0123456789abcdef/a1b2c3
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# 3) Self-hosted Jitsi: rooms are embedded from your server (host[:port], no
#    scheme or path). NEXT_PUBLIC_JITSI_DOMAIN is a legacy alias.
# JITSI_DOMAIN=meet.your-trust.nhs.uk
#    Optional token auth (Prosody "token"; docker-jitsi-meet: ENABLE_AUTH=1,
#    AUTH_TYPE=jwt, JWT_APP_ID, JWT_APP_SECRET). Set both or neither; without
#    them the room is open to anyone with its link.
# JITSI_APP_ID=petrios
# JITSI_APP_SECRET=...
#    Optional claim overrides: aud defaults to "jitsi"; sub defaults to the
#    JITSI_DOMAIN host. docker-jitsi-meet needs its XMPP domain as sub.
# JITSI_JWT_AUDIENCE=jitsi
# JITSI_JWT_SUBJECT=meet.jitsi
#    Only hosts moderate, and only pass holders join, if your Jitsi server has
#    guest access off, Jicofo auto-owner off and a module that applies the
#    token's moderator claim (docs/self-hosting.md "Self-hosted Jitsi").
#
# External teachers (no account) join token-protected rooms from their RSVP
# link. Their invite code unlocks that only after the operator has removed
# migration 017's public teacher_invitations policies (SQL in spec/13,
# "External teacher invite codes") and then set this to exactly "true".
# Until then external teachers get no embedded room pass and their RSVP page
# shows session details to signed-in organisation members only.
# TEACHER_INVITATIONS_RLS_LOCKED=true

# --- Self-hosted SMTP (takes priority over Resend when SMTP_HOST is set) ------
# SMTP_HOST=mail.your-trust.nhs.uk
# SMTP_PORT=587
# SMTP_USER=petrios
# SMTP_PASS=...
# SMTP_SECURE=false                                # true for implicit TLS (465)

# --- Self-hosted / gateway AI endpoint -----------------------------------------
# OpenAI-compatible base URL (Azure OpenAI, a gateway, or a local model) for
# text AI inside your network. Audio Recap (and so Recall) also needs /responses
# file inputs and hosted web search, which reach public sites; ElevenLabs speech
# is always external. Default: https://api.openai.com/v1
# Pin it with LLM_PROVIDER=openai: an ANTHROPIC_API_KEY present in the same
# environment otherwise disables AI with a configuration error (never a silent switch).
# OPENAI_BASE_URL=https://your-gateway.internal/v1

# --- Migration runner (self-hosted; scripts/migrate.mjs) -----------------------
# DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# --- Federation (optional) ------------------------------------------------------
# Ed25519 seed enabling signed teaching-record exports; generate with:
#   node scripts/generate-instance-key.mjs
# INSTANCE_SIGNING_KEY=base64-seed

# --- SEO / Search Console (optional) --------------------------------------------
# Token from Google Search Console's "HTML tag" verification method (the
# content="..." value only). Renders the verification meta tag site-wide.
# GOOGLE_SITE_VERIFICATION=abc123

# --- Attendance rate limiting (optional) -----------------------------------------
# HMAC key used to pseudonymize check-in IPs for group-code throttling.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset; set a dedicated value
# if you rotate the service key or want key separation.
# ATTENDANCE_RATE_LIMIT_SECRET=
