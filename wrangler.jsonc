// Cloudflare Workers configuration (docs/cloudflare-workers.md). The Docker/Node
// build (self-hosting) ignores this file. The TOP LEVEL is the staging Worker:
// workers.dev only and no cron triggers, because the production Worker runs the
// cron jobs against the same database. Deploy it only with
// `npm run cf:deploy:staging`. The production Worker is env.production below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petrios-staging",
  "main": "cfw/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Module rules apply only under cfw/: the precompiled yoga.wasm and the fonts
  // copied by cf:build, which the app reads from /bundle/public/fonts via node:fs.
  // fallthrough keeps wrangler's default Data rule (**/*.bin) that next/og needs.
  "base_dir": "cfw",
  "find_additional_modules": true,
  "rules": [{ "type": "Data", "globs": ["public/fonts/*.ttf"], "fallthrough": true }],

  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // OpenNext's self-reference binding; the service name must match the Worker name.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "petrios-staging" }],
  "observability": { "enabled": true },
  "send_metrics": false,

  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": [] },

  "vars": {
    // Set per deploy by cf:deploy:staging (validated); empty fails closed for email links.
    "APP_URL": "",
    // scheduled() dispatches nothing unless this is exactly "true".
    "CRON_ENABLED": "false",
    // Staging serves the production database, so lib/email.ts refuses every
    // send (except to OUTBOUND_EMAIL_ALLOWLIST secret addresses). Real users
    // must never get links or certificates that point at workers.dev.
    "OUTBOUND_EMAIL_ENABLED": "false",
    // Cloudflare overwrites this header; the first x-forwarded-for hop is
    // client-supplied, so rate limits (lib/rate-limit.ts) must not trust it.
    "TRUSTED_CLIENT_IP_HEADER": "cf-connecting-ip",
    // Names Cloudflare Workers as the host on /privacy and /subprocessors.
    "HOSTING_PROVIDER": "cloudflare-workers",
    // Rota availability (spec/14) stays off on staging, which serves the
    // production database (stagingConfigProblems enforces "false").
    "ROTA_INTEGRATION_ENABLED": "false"
  },
  // Deploy fails unless these exist as Worker secrets (wrangler secret put).
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY", "CRON_SECRET"]
  },

  "env": {
    // PRODUCTION (petrios.uk; the only production host since 2026-10-11, when
    // Render was retired). Deploy ONLY with `npm run cf:deploy:production --
    // deploy` (docs/cloudflare-workers.md, "Production");
    // scripts/cloudflare/lib.mjs productionConfigProblems() and its tests
    // enforce everything below. This is the ONLY scheduler of the cron jobs and
    // the only host that emails real users. Add no other environment that
    // deploys the Worker "petrios": wrangler would replace the live version
    // with it on these custom domains (why env.production_preflight, which had
    // email and crons off, was removed).
    "production": {
      "name": "petrios",
      // Pinned so every step (secret upload, deploys, rollback and the API
      // reads) targets the one account that owns petrios.uk.
      "account_id": "610371b5de9811b7d258c7622c23849b",
      "workers_dev": false,
      "preview_urls": false,
      // The COMPLETE set of Workers Custom Domains of this Worker (Cloudflare
      // manages their DNS records). Wrangler publishes custom domains with
      // replace_state=true, so a hostname dropped from this list is detached on
      // the next deploy and its DNS record deleted; and when it is not run
      // interactively it takes over a conflicting DNS record or another
      // Worker's hostname without asking (cf:deploy:production previews the
      // change and refuses both). Bare hostnames only, never a plain route.
      // www.petrios.uk is a zone-level 301 to https://petrios.uk/, not this
      // Worker: leave it out.
      "routes": [
        { "pattern": "petrios.uk", "custom_domain": true },
        { "pattern": "app.petrios.uk", "custom_domain": true }
      ],
      // services, vars and secrets are never inherited from the top level.
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "petrios" }],
      // Must equal cfw/cron.ts CRON_SCHEDULE (cfw/cron.test.ts, lib.test.ts). UTC.
      "triggers": {
        "crons": ["0 * * * *", "15 * * * *", "5,20,35,50 * * * *", "0 8 * * *", "30 6 * * *", "0 7 * * MON"]
      },
      "vars": {
        // The public origin in every email link, certificate QR code and cron
        // dispatch. app.petrios.uk serves the same Worker; links use the apex.
        "APP_URL": "https://petrios.uk",
        "CRON_ENABLED": "true",
        "OUTBOUND_EMAIL_ENABLED": "true",
        "TRUSTED_CLIENT_IP_HEADER": "cf-connecting-ip",
        "HOSTING_PROVIDER": "cloudflare-workers",
        // Rota availability (spec/14): "false" until the owner's go-live
        // (docs/rota.md), after migrations 063/064 and the ROTA_IDENTITY_SECRET
        // secret are in place; then only this value becomes "true".
        "ROTA_INTEGRATION_ENABLED": "false"
      },
      // Deploy fails unless these exist as secrets of the "petrios" Worker.
      // MAIL_FROM: lib/email.ts cannot send without it. PRIVACY_CONTROLLER_NAME
      // and PRIVACY_CONTACT_EMAIL: the public disclosures (lib/compliance.ts).
      // The address, DATA_HOSTING_REGION and DATA_TRANSFER_SAFEGUARDS are
      // optional secrets; set them, naming Cloudflare, once the controller has them.
      "secrets": {
        "required": [
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "CRON_SECRET",
          "RESEND_API_KEY",
          "MAIL_FROM",
          "PRIVACY_CONTROLLER_NAME",
          "PRIVACY_CONTACT_EMAIL"
        ]
      }
    }
  }
}
